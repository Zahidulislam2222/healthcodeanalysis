# Legacy WordPress automation settings. The local editorial frontend requires no secrets.
# Frontend build/runtime configuration: frontend/site.config.json.
WP_SITE_URL=https://example.test
WP_USERNAME=not-configured
WP_APP_PASSWORD=
HC_API_KEY=
CPANEL_URL=https://example.test
CPANEL_USERNAME=not-configured
CPANEL_API_TOKEN=
SOFTACULOUS_URL=https://example.test

# Optional, offline media production only; never exposed to the frontend.
OPENROUTER_API_KEY=
